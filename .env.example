# Ghost Engine configuration.
# Copy to engine/.env and fill in. Never commit the filled-in file.

# --- Required: the engine refuses to start without these ---------------------

# Kalshi API credentials (production). Demo mode has been removed.
KALSHI_PROD_KEY_ID=your_kalshi_key_id
KALSHI_PROD_PRIVATE_KEY=your_kalshi_private_key_pem

# API key guarding the engine's HTTP endpoints.
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
GHOST_API_KEY=generate_a_random_key

# Dashboard login password. There is no default: a password written into the
# source is published with it.
#   python -c 'import secrets; print(secrets.token_urlsafe(16))'
AUTH_PASSWORD=choose_a_strong_password

# --- Optional: AI analysis (the Brain degrades gracefully without these) -----

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash-exp
OPENROUTER_API_KEY=your_openrouter_key

# --- Optional: Supabase persistence ------------------------------------------

SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_key

# --- Optional: trading and safety limits -------------------------------------

VAULT_PRINCIPAL_CENTS=30000        # principal capital, cents (default 30000)
VAULT_PROFIT_THRESHOLD_CENTS=5000  # daily profit threshold, cents
KILL_SWITCH=false
IS_PRODUCTION=false

# Pins every cycle to paper trading, whatever the dashboard requests.
# Keep this set until you have decided to go live.
IS_PAPER_TRADING=true

# NOT configurable here -- these are constants in engine/core/constants.py:
#   BRAIN_CONFIDENCE_THRESHOLD  0.85    minimum AI confidence to trade
#   BRAIN_MAX_VARIANCE          0.25    variance above this vetoes a trade
#   HAND_MAX_STAKE_CENTS        7500    $75 maximum per trade
#   HARD_FLOOR_CENTS            25500   $255 floor, below which trading stops
# engine/config.py reads CONFIDENCE_THRESHOLD and MAX_VARIANCE from the
# environment, but nothing imports that module, so setting them has no effect.
# Change the constants instead, and re-run the test suite.

# --- Optional: trade alerts (ntfy.sh push notifications) ---------------------

NTFY_TOPIC=kalshi-alerts

# --- Optional: runtime -------------------------------------------------------

PORT=3002
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO
JSON_LOGS=false

# --- Optional: test overrides ------------------------------------------------
# The test suite sets these to temporary paths automatically; set them only to
# point a local run at a scratch database.
# GHOST_VAULT_DB=engine/ghost_memory.db
# GHOST_SYNAPSE_DB=ghost_memory.db
