# ============================================
# Kalshi Trading Engine - Environment Configuration
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit the actual .env file to git

# ============================================
# GHOST API Authentication
# ============================================
# Generate a strong random key for API authentication
GHOST_API_KEY=ghost_prod_key_REPLACE_WITH_SECURE_RANDOM

# Password for dashboard authentication. REQUIRED -- the engine refuses to
# start without it, deliberately: there is no development default any more.
# The value that used to sit here was a real password and is still in git
# history. If you used it, rotate it.
AUTH_PASSWORD=

# ============================================
# Kalshi API Configuration
# ============================================
# These are the only Kalshi variables the engine reads. KALSHI_DEMO_KEY_ID and
# KALSHI_DEMO_PRIVATE_KEY were documented here but no code has read them since
# demo mode was removed -- setting them did nothing.
KALSHI_PROD_KEY_ID=your-prod-key-id
KALSHI_PROD_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
YOUR_PROD_PRIVATE_KEY_HERE
-----END RSA PRIVATE KEY-----"

# ============================================
# Supabase Database Configuration
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key

# ============================================
# AI Service API Keys
# ============================================
# Google AI Studio (Gemini)
GEMINI_API_KEY=your-gemini-api-key

# OpenRouter (optional)
OPENROUTER_API_KEY=your-openrouter-api-key

# Groq (optional)
GROQ_API_KEY=your-groq-api-key

# ============================================
# External Services
# ============================================
# RapidAPI - only needed for external odds comparison (optional)
RAPID_API_KEY=your-rapidapi-key
NTFY_TOPIC=kalshi-alerts

# ============================================
# Trading Configuration
# ============================================
# Set to "true" for production trading (uses real money)
IS_PRODUCTION=false

# Pins every cycle to paper on this machine, whatever the dashboard requests.
# In paper mode orders are simulated and never reach Kalshi. Leave this set
# until you have deliberately decided to trade real money.
IS_PAPER_TRADING=true

# Vault settings (in cents)
VAULT_PRINCIPAL_CENTS=30000
VAULT_PROFIT_THRESHOLD_CENTS=5000

# Emergency kill switch (set to "true" to halt all trading)
KILL_SWITCH=false

# ============================================
# Frontend Configuration
# ============================================
FRONTEND_ORIGIN=http://localhost:3000
